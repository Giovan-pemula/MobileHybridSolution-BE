{
  "info": {
    "name": "Udemy Clone API",
    "description": "Postman Collection for Udemy Clone Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.token) { pm.collectionVariables.set('token', jsonData.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Artificial Intelligence\",\n  \"slug\": \"ai\",\n  \"description\": \"AI & ML\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Courses & Sections",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/courses?limit=10&page=1&status=PUBLISHED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "status",
                  "value": "PUBLISHED"
                }
              ]
            }
          }
        },
        {
          "name": "Create Course (Trainer/Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mastering React 18\",\n  \"description\": \"Learn React from scratch\",\n  \"price\": 50,\n  \"isFree\": false,\n  \"categoryId\": 1,\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses"
              ]
            }
          }
        },
        {
          "name": "Create Section",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/1/sections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "1",
                "sections"
              ]
            }
          }
        },
        {
          "name": "Create Lesson",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"What is React?\",\n  \"youtubeUrl\": \"https://youtube.com/watch?v=123\",\n  \"duration\": 600,\n  \"isPreview\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sections/1/lessons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sections",
                "1",
                "lessons"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Student Enrollment",
      "item": [
        {
          "name": "Enroll in Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/1/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "1",
                "enroll"
              ]
            }
          }
        },
        {
          "name": "Get My Enrolled Courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/my-courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "my-courses"
              ]
            }
          }
        },
        {
          "name": "Toggle Lesson Completion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lessons/1/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lessons",
                "1",
                "complete"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Purchases & Orders",
      "item": [
        {
          "name": "Create Order (Purchase Courses)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseIds\": [\n    1\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Reviews & Discussions",
      "item": [
        {
          "name": "Add Course Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"review\": \"Great course!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/1/rating",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "1",
                "rating"
              ]
            }
          }
        },
        {
          "name": "Add Lesson Discussion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"I don't understand hooks.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lessons/1/discussions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lessons",
                "1",
                "discussions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. Dashboard & Analytics",
      "item": [
        {
          "name": "Student Learning Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/learning",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "learning"
              ]
            }
          }
        },
        {
          "name": "Trainer Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trainer/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trainer",
                "dashboard"
              ]
            }
          }
        }
      ]
    }
  ]
}